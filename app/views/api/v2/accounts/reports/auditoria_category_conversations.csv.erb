    I18n.t('reports.auditoria_category_conversations_csv.conversation_id'),
    I18n.t('reports.auditoria_category_conversations_csv.contact_name'),
    I18n.t('reports.auditoria_category_conversations_csv.assignee_name'),
    I18n.t('reports.auditoria_category_conversations_csv.inbox_name'),
    I18n.t('reports.auditoria_category_conversations_csv.last_activity_at'),
    I18n.t('reports.auditoria_category_conversations_csv.match_reasons')
  ]
%>
<%= CSVSafe.generate_line headers -%>
<% @report_data.each do |row| %>
<%= CSVSafe.generate_line row -%>
<% end %>
