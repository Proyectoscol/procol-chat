# coturn — TURN/STUN para WebRTC (VPS-2).
# Sin esto, ~20% de asesores detrás de NAT simétrico no tienen audio.
# Instalar: TURN_USERNAME=x TURN_CREDENTIAL=y PUBLIC_IP=z bash deploy/coturn/install.sh

listening-port=3478
tls-listening-port=5349

listening-ip=0.0.0.0
external-ip=__IP_PUBLICA_VPS2__         # ej: 2.25.200.186

realm=freebpx.procol-proyectoscol.com

# Autenticación de largo plazo — valores deben coincidir con
# TURN_USERNAME y TURN_CREDENTIAL en Rails (.env de VPS-1).
# Alternativa más segura para producción: cambiar a use-auth-secret +
# static-auth-secret; Rails generaría credenciales efímeras HMAC por sesión.
lt-cred-mech
user=__TURN_USERNAME__:__TURN_CREDENTIAL__

# Rango relay (abrir UDP en firewall).
min-port=49152
max-port=65535

log-file=/var/log/coturn/turnserver.log
simple-log

# Endurecimiento
no-multicast-peers
stale-nonce
fingerprint
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
