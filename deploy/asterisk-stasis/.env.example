# Conexión ARI (local en VPS-2 — nunca exponer al exterior)
ARI_URL=http://127.0.0.1:8088
ARI_USERNAME=asterisk
ARI_PASSWORD=changeme

# Nombre de la Stasis app (debe coincidir con extensions_custom.conf)
ARI_APP=stasis-routing

# Rails (VPS-1) — usar IP privada o nombre DNS interno
RAILS_INTERNAL_URL=https://chat.procol-proyectoscol.com/api/v1/internal
SIP_INTERNAL_TOKEN=__mismo_valor_que_SIP_INTERNAL_TOKEN_en_Rails__

# Dialplan de FreePBX al que continuar cuando no hay asesor disponible
FALLBACK_CONTEXT=from-voicemail

# Timeout de marcación por asesor (segundos)
DIAL_TIMEOUT_SECONDS=30

# IVR: nombre del sonido en Asterisk (sin extensión) y timeout de dígito (segundos)
IVR_PROMPT=ivr-ciudades
IVR_DIGIT_TIMEOUT=10
